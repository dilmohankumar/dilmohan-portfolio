NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=your-app

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Credentials for the ONE-TIME seed script (server/src/seed/seed.js) that creates the first
# (owner) account. Not read anywhere else. New users sign up normally via /signup afterward.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_USERNAME=your-username

BCRYPT_SALT_ROUNDS=12

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
